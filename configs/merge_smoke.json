{
  "phase": 50,
  "title": "Model Merging / Weight Averaging smoke config",
  "description": "Reference flags for a tiny two-input smoke merge. The actual smoke (scripts/phase50_smoke.sh) builds synthetic checkpoints in a temp dir at runtime and does not read this file; this config documents the canonical flag shapes for operators.",
  "linear_example": {
    "method": "linear",
    "inputs": ["checkpoints/math_dora.safetensors", "checkpoints/chat_dpo.safetensors"],
    "weights": [0.5, 0.5],
    "output": "checkpoints/soup.safetensors"
  },
  "task_arithmetic_example": {
    "method": "task-arithmetic",
    "base": "checkpoints/base.safetensors",
    "deltas": ["checkpoints/math_dora.safetensors", "checkpoints/chat_dpo.safetensors"],
    "scales": [1.0, 0.5],
    "output": "checkpoints/merged.safetensors"
  },
  "ties_example": {
    "method": "ties",
    "base": "checkpoints/base.safetensors",
    "deltas": ["checkpoints/math_dora.safetensors", "checkpoints/chat_dpo.safetensors"],
    "scales": [1.0, 1.0],
    "density": 0.5,
    "normalize": true,
    "output": "checkpoints/ties.safetensors"
  },
  "dare_example": {
    "method": "dare",
    "base": "checkpoints/base.safetensors",
    "deltas": ["checkpoints/math_dora.safetensors", "checkpoints/chat_dpo.safetensors"],
    "scales": [1.0, 0.5],
    "density": 0.5,
    "seed": 42,
    "output": "checkpoints/dare.safetensors"
  }
}
